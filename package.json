{
  "name": "@theimpostor/mcjs",
  "version": "0.1.0",
  "private": true,
  "description": "Programmable Minecraft bots for coding agents, powered by Bun and Mineflayer",
  "type": "module",
  "bin": {
    "mcjs": "./dist/mcjs"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --compile --bytecode --minify --keep-names --sourcemap --no-compile-autoload-dotenv --no-compile-autoload-bunfig --no-compile-autoload-tsconfig --no-compile-autoload-package-json --outfile ./dist/mcjs",
    "mcjs": "bun src/cli.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check": "bun run lint && bun run typecheck && bun run test",
    "test:integration": "bun test integration"
  },
  "dependencies": {
    "minecraft-data": "3.117.0",
    "mineflayer": "4.39.0",
    "mineflayer-collectblock": "1.6.0",
    "mineflayer-pathfinder": "2.4.5",
    "mineflayer-pvp": "1.3.2",
    "mineflayer-tool": "1.2.0",
    "vec3": "0.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "flying-squid": "1.12.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
